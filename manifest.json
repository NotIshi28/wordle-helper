{
  "name": "Wordle Helper",
  "description": "A Chrome extension that helps you solve Wordle puzzles.",
  "version": "3.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*://*",
    "*://*/*" 
  ],
  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/games/wordle/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}